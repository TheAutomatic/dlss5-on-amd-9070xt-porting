+// Set by Submitted when our split list ran on a queue other than the session's; Record rebuilds the session there.
+static ID3D12CommandQueue *g_requeue = nullptr;
+
 ID3D12Resource *LmxxfBackend::Record(ID3D12GraphicsCommandList *cmd, const AmdPreSr::Frame &frame,
                                      const AmdPreSr::Settings &settings)
 {
+    if (g_requeue && !pendingJob)
+    {
+        if (g_requeue != queue)
+        {
+            if (session && api && api->table.Destroy)
+                api->table.Destroy(session);
+            session = nullptr;
+            sessionReady = false;
+            g_requeue->AddRef();
+            if (queue)
+                queue->Release();
+            queue = g_requeue;
+            LOG_INFO("lmxxf: game submits on a new queue {}; session rebuilt there", static_cast<void *>(queue));
+        }
+        g_requeue = nullptr;
+    }
+    // A job whose list was never submitted (or submitted where Submitted() cannot see it, e.g. across a swapchain
+    // rebuild) would otherwise block every later frame until restart. After a few evaluations, give it up.
+    static unsigned stalledEvaluations = 0;
+    if(pendingJob && ++stalledEvaluations >= 8){
+        const bool enqueued = LmxxfCut::Pending().job != pendingJob;
+        if(enqueued) api->table.Retire(session, pendingJob); else api->table.CancelUnsubmitted(session, pendingJob);
+        LmxxfCut::ClearPendingEnqueue();
+        pendingJob = nullptr;
+        static unsigned recoveries = 0;
+        if(++recoveries <= 5 || recoveries % 100 == 0)
+            LOG_WARN("lmxxf: stalled job recovered ({}; recovery {})", enqueued ? "retired" : "cancelled", recoveries);
+    }
+    if(pendingJob){SetStatus("lmxxf: prior job not yet submitted; original SR");return nullptr;}
+    stalledEvaluations = 0;
     LmxxfCut::ClearPendingEnqueue();
     pendingJob = nullptr;
