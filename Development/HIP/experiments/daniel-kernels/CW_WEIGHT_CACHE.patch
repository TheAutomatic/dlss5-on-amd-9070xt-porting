+DEV i2 cw_cached_weight(const float*w,uint offset){
+ i2 b=matrix8(w,offset);int lo=b[0],hi=b[1];
+ // Opaque register results prevent LLVM from replacing each use with a fresh potentially-aliasing load.
+ __asm__ volatile("" : "+v"(lo),"+v"(hi));return i2{lo,hi};
+}
